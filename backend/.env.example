# ============================================
# TopicAI v4.0 "Air Pro" — Environment Variables
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ==================== Application ====================
ENVIRONMENT=development
DEBUG=true
APP_NAME=TopicAI
APP_VERSION=4.0.0
LOG_LEVEL=INFO

# ==================== Database ====================
# SQLite (WAL mode) — local file path
DATABASE_URL=sqlite+aiosqlite:///./data/topicai.db

# ChromaDB persistence directory
CHROMA_PERSIST_DIR=./data/chroma

# ==================== LLM Providers ====================

# DeepSeek V4 (Primary) — https://platform.deepseek.com
# Model: deepseek-v4-flash (default, 2500 concurrency)
# Pro: deepseek-v4-pro (500 concurrency, thinking mode)
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# Qwen (Hot Standby) — https://dashscope.aliyun.com
# Model: qwen-plus (recommended), qwen-turbo (low-cost), qwen-max (high-quality)
DASHSCOPE_API_KEY=sk-your-dashscope-api-key

# GLM-5V-Turbo (Vision) — https://open.bigmodel.cn
# Model: glm-5v-turbo (200K context, 128K output)
ZHIPU_API_KEY=your-zhipu-api-key

# ==================== Data Sources ====================

# TianAPI (热搜数据) — https://www.tianapi.com
# Free tier: 100 calls/day, 3 QPS, 10 interfaces
TIANAPI_KEY=your-tianapi-key

# ==================== Authentication ====================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=change-me-to-a-random-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ==================== Rate Limiting ====================
# Free user AI call limit per day
AI_CALLS_PER_DAY=20

# ==================== Monitoring (Optional for MVP) ====================
# Sentry — Error tracking (https://sentry.io)
SENTRY_DSN=

# LangFuse — LLM observability (https://langfuse.com)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# PostHog — Product analytics (https://posthog.com)
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com

# ==================== Backup ====================
BACKUP_DIR=./backups
BACKUP_RETENTION_COUNT=30
BACKUP_SCHEDULE_HOUR=3
BACKUP_SCHEDULE_MINUTE=0

# ==================== Content Cleanup ====================
CONTENT_RETENTION_DAYS=90
